model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["national_trend","regional_trend","state_monthly","state_outliers"]

ref table DateTable
ref table national_trend
ref table regional_trend
ref table state_monthly
ref table state_outliers

ref cultureInfo en-US

