		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DateTable = calculated
		mode: import
		source = CALENDAR(MIN(national_trend[month_date]), MAX(national_trend[month_date]))

	annotation PBI_Id = a89446f5506f4e7a9a1019ce86cd2998

