# secrets
.env

# raw data - downloaded manually per README, never committed
data/raw/*
!data/raw/.gitkeep

# local DuckDB database file - rebuilt from sql/ scripts
*.duckdb
*.duckdb.wal

# notebook/python noise
.ipynb_checkpoints/
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Power BI Project (PBIP) local cache/session state - regenerates automatically
# on open, not meaningful for source control (and cache.abf is a large binary blob)
**/.pbi/cache.abf
**/.pbi/localSettings.json
